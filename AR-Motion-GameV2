<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ภารกิจมือสะอาด - AR Motion Game</title>
    
    <!-- Tailwind CSS for rapid styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Kanit -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;500;700;900&display=swap" rel="stylesheet">
    
    <!-- MediaPipe Hands Libraries (via jsDelivr) -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>

    <style>
        body {
            font-family: 'Kanit', sans-serif;
            overflow: hidden; /* Prevent scrolling */
            touch-action: none; /* Prevent default touch actions on mobile */
            background-color: #111827;
        }

        /* Glassmorphism styling for UI panels */
        .glass-panel {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
        }

        /* Fun pulsing animation for important texts */
        @keyframes pulse-fast {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        .animate-pulse-fast {
            animation: pulse-fast 1s infinite ease-in-out;
        }

        /* Floating animation for start screen elements */
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }
        .animate-float {
            animation: float 4s ease-in-out infinite;
        }

        /* Hide elements gracefully */
        .fade-out {
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.5s ease;
        }
        .fade-in {
            opacity: 1;
            pointer-events: auto;
            transition: opacity 0.5s ease;
        }
    </style>
</head>
<body class="text-white">

    <div id="app" class="relative w-screen h-screen">
        
        <!-- Camera Video Feed (Hidden, used for processing) -->
        <video id="webcam" class="hidden" autoplay playsinline></video>
        
        <!-- Main Game Canvas -->
        <canvas id="game-canvas" class="absolute inset-0 z-0 w-full h-full"></canvas>

        <!-- Floating Mute Button -->
        <button id="mute-btn" onclick="toggleMute()" class="absolute top-6 right-6 z-50 glass-panel w-16 h-16 rounded-full text-3xl flex items-center justify-center hover:bg-white/30 transition-colors">
            🔊
        </button>

        <!-- Loading AI Screen -->
        <div id="loading-screen" class="absolute inset-0 z-50 flex flex-col items-center justify-center bg-gray-900 transition-opacity duration-500">
            <div class="text-7xl mb-6 animate-spin">⏳</div>
            <h2 class="text-4xl font-black text-yellow-400 drop-shadow-md">กำลังเตรียมพลังฮีโร่...</h2>
            <p class="mt-4 text-xl text-gray-300">กรุณาอนุญาตการเข้าถึงกล้องและรอโหลด AI สักครู่</p>
        </div>

        <!-- Start Screen -->
        <div id="start-screen" class="absolute inset-0 z-40 flex flex-col items-center justify-center bg-black/60 fade-out">
            <div class="animate-float flex flex-col items-center">
                <div class="text-8xl mb-2">🦸‍♂️🧼🦠</div>
                <h1 class="text-6xl md:text-8xl font-black text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 to-green-400 drop-shadow-[0_5px_5px_rgba(0,0,0,0.8)] mb-6 text-center">
                    ภารกิจมือสะอาด
                </h1>
            </div>
            <div class="glass-panel px-8 py-6 rounded-3xl mb-10 max-w-2xl text-center">
                <h3 class="text-2xl font-bold text-yellow-200 mb-2">วิธีเล่นด้วยมือเปล่า (AR Mode)</h3>
                <p class="text-xl text-gray-100">
                    1. ถอยห่างจากกล้อง 1 ช่วงแขน ให้เห็นมือชัดเจน<br>
                    2. ใช้มือของคุณ "สัมผัส" และ "ปัดกวาด" เชื้อโรคบนหน้าจอ<br>
                    3. แช่มือค้างไว้บนปุ่ม เพื่อกดตกลง
                </p>
            </div>
            <!-- AR Interactable Button -->
            <div id="btn-start" class="ar-interact px-10 py-5 bg-gradient-to-r from-green-500 to-emerald-400 rounded-full text-4xl font-black shadow-[0_0_30px_rgba(16,185,129,0.6)] border-4 border-white cursor-pointer relative overflow-hidden transition-transform transform scale-100">
                เริ่มล้างมือกันเลย!
            </div>
        </div>

        <!-- Play Screen HUD -->
        <div id="hud" class="absolute inset-0 z-10 pointer-events-none fade-out flex flex-col justify-between p-6 md:p-10">
            <!-- Top bar: Score and Timer -->
            <div class="flex justify-between items-start w-full max-w-6xl mx-auto">
                <div class="glass-panel px-6 py-3 rounded-2xl flex flex-col items-center min-w-[150px]">
                    <span class="text-lg font-bold text-gray-200">คะแนนฮีโร่</span>
                    <span id="ui-score" class="text-4xl md:text-5xl font-black text-yellow-400">0</span>
                </div>
                <div class="glass-panel px-6 py-3 rounded-2xl flex flex-col items-center min-w-[150px] border-red-400/50">
                    <span class="text-lg font-bold text-gray-200">เวลาโบนัส</span>
                    <span id="ui-timer" class="text-4xl md:text-5xl font-black text-red-400 animate-pulse-fast">15</span>
                </div>
            </div>

            <!-- Bottom bar: Stage Instructions -->
            <div class="flex flex-col items-center mb-8">
                <div id="ui-stage-title" class="text-4xl md:text-6xl font-black text-white drop-shadow-[0_4px_4px_rgba(0,0,0,1)] mb-2 text-center">
                    1. ใส่สบู่ให้พร้อม
                </div>
                <div id="ui-stage-desc" class="text-2xl md:text-3xl font-bold text-yellow-300 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] text-center glass-panel px-8 py-2 rounded-full">
                    แตะที่สบู่เพื่อเริ่มต้น!
                </div>
            </div>
        </div>

        <!-- Missing Hand Warning Overlay -->
        <div id="bounds-warning" class="absolute inset-0 z-30 pointer-events-none fade-out border-[12px] border-red-500 bg-red-500/20 flex flex-col items-center justify-center">
             <div class="text-8xl mb-4">🖐️❓</div>
             <div class="text-4xl md:text-5xl font-black text-white bg-red-600 px-10 py-5 rounded-full shadow-2xl animate-pulse-fast">
                 ไม่พบมือ! ขยับให้อยู่ในหน้ากล้อง
             </div>
        </div>

        <!-- Game Over Screen -->
        <div id="game-over-screen" class="absolute inset-0 z-40 flex flex-col items-center justify-center bg-black/80 fade-out">
            <h1 class="text-6xl md:text-7xl font-black text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 to-yellow-600 drop-shadow-[0_5px_5px_rgba(0,0,0,0.8)] mb-2 text-center">
                ภารกิจสำเร็จ! 🎉
            </h1>
            <div class="text-3xl mb-8 flex items-center gap-4">
                ระดับของคุณ: 
                <span id="ui-rank" class="font-black text-green-400 text-5xl bg-white/10 px-6 py-2 rounded-full border-2 border-green-400">
                    ฮีโร่มือสะอาด
                </span>
            </div>
            
            <div class="glass-panel p-8 rounded-3xl w-full max-w-md text-center mb-10 border-t-4 border-t-yellow-400">
                <div class="text-2xl text-gray-300 mb-2">คะแนนรวมทั้งหมด</div>
                <div id="ui-final-score" class="text-7xl font-black text-white drop-shadow-lg mb-6">9500</div>
                
                <div class="flex justify-between items-center bg-black/30 p-4 rounded-xl">
                    <span class="text-xl text-gray-300">เชื้อโรคที่กำจัดได้</span>
                    <span class="text-3xl font-bold text-yellow-300"><span id="ui-kills">45</span> ตัว</span>
                </div>
            </div>

            <!-- AR Interactable Replay Button -->
            <div id="btn-replay" class="ar-interact px-10 py-5 bg-gradient-to-r from-pink-500 to-orange-400 rounded-full text-4xl font-black shadow-[0_0_30px_rgba(236,72,153,0.6)] border-4 border-white cursor-pointer relative overflow-hidden">
                เล่นอีกครั้ง!
            </div>
        </div>
    </div>

    <script>
        // --- AUDIO SYSTEM (Web Audio API) ---
        let audioCtx;
        let isMuted = false;

        function toggleMute() {
            isMuted = !isMuted;
            document.getElementById('mute-btn').innerText = isMuted ? '🔇' : '🔊';
        }

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        // Procedural sound effects generator
        function playSound(type) {
            if (isMuted || !audioCtx) return;
            const now = audioCtx.currentTime;
            
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (type === 'hover') {
                // Gentle tick while loading button
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, now);
                osc.frequency.exponentialRampToValueAtTime(800, now + 0.05);
                gain.gain.setValueAtTime(0.05, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);
                osc.start(now);
                osc.stop(now + 0.05);
            } 
            else if (type === 'pop') {
                // Bubble pop for germ kill
                osc.type = 'sine';
                osc.frequency.setValueAtTime(800, now);
                osc.frequency.exponentialRampToValueAtTime(1500, now + 0.05);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
                osc.start(now);
                osc.stop(now + 0.1);
            }
            else if (type === 'hit') {
                // Thud sound for hitting boss
                osc.type = 'square';
                osc.frequency.setValueAtTime(150, now);
                osc.frequency.exponentialRampToValueAtTime(40, now + 0.1);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
                osc.start(now);
                osc.stop(now + 0.1);
            }
            else if (type === 'success') {
                // Clear stage
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(440, now); // A4
                osc.frequency.setValueAtTime(554.37, now + 0.1); // C#5
                osc.frequency.setValueAtTime(659.25, now + 0.2); // E5
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.4);
                osc.start(now);
                osc.stop(now + 0.4);
            }
            else if (type === 'win') {
                // Game Over Victory Arpeggio
                const notes = [440, 554.37, 659.25, 880];
                notes.forEach((freq, i) => {
                    const o = audioCtx.createOscillator();
                    const g = audioCtx.createGain();
                    o.connect(g);
                    g.connect(audioCtx.destination);
                    o.type = 'sine';
                    o.frequency.value = freq;
                    g.gain.setValueAtTime(0.3, now + i * 0.15);
                    g.gain.linearRampToValueAtTime(0, now + i * 0.15 + 0.3);
                    o.start(now + i * 0.15);
                    o.stop(now + i * 0.15 + 0.3);
                });
            }
        }

        // --- GAME DATA & LOGIC ---
        
        // 7 Steps of Hand Washing mapped to AR minigames
        const STAGES = [
            { title: "1. ทำมือเปียก & ใส่สบู่", type: "soap", count: 1, duration: 15, instruction: "แตะที่ก้อนสบู่เพื่อเริ่มล้างมือ!" },
            { title: "2. ถูฝ่ามือ", type: "germ_center", count: 6, duration: 15, instruction: "ถูฝ่ามือเข้าด้วยกัน ปราบเชื้อโรคตรงกลาง!" },
            { title: "3. ถูหลังมือ", type: "germ_sides", count: 6, duration: 15, instruction: "อย่าลืมถูหลังมือ กำจัดเชื้อโรคด้านข้าง!" },
            { title: "4. ถูซอกนิ้ว", type: "germ_scatter", count: 8, duration: 15, instruction: "ถูซอกนิ้วให้สะอาด ถูพวกมันให้หมด!" },
            { title: "5. ถูหัวแม่มือ", type: "germ_tough", count: 2, duration: 15, instruction: "กำมือถูหัวแม่มือ ปราบลูกพี่เชื้อโรค!" },
            { title: "6. ถูปลายนิ้วและเล็บ", type: "germ_small", count: 10, duration: 15, instruction: "ถูปลายนิ้วบนฝ่ามือ เก็บกวาดตัวเล็กๆ!" },
            { title: "7. ล้างน้ำและเช็ดแห้ง", type: "water", count: 8, duration: 15, instruction: "แตะหยดน้ำเพื่อล้างฟองสบู่ออกให้หมด!" },
            { title: "ด่านสุดท้าย: บอสเชื้อโรค!", type: "boss", count: 1, duration: 20, instruction: "ระดมถูมือ โจมตีบอสให้พ่ายแพ้!!" }
        ];

        let gameState = 'INIT'; // INIT, START, PLAYING, GAMEOVER
        let currentStageIndex = 0;
        let score = 0;
        let killCount = 0;
        let stageTimeLeft = 0;
        let noHandTimer = 0;
        let gameTimerInterval = null;
        
        let gameObjects = [];
        let particles = [];

        const canvas = document.getElementById('game-canvas');
        const ctx = canvas.getContext('2d');
        
        // Resize canvas to match screen
        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // Game Object Entity
        class Entity {
            constructor(x, y, radius, type, stageType) {
                this.x = x;
                this.y = y;
                this.radius = radius;
                this.type = type; // 'soap', 'germ', 'water', 'boss'
                this.stageType = stageType;
                
                // Randomize velocity based on type
                this.vx = (Math.random() - 0.5) * 6;
                this.vy = (Math.random() - 0.5) * 6;
                
                if (type === 'soap') { this.vx = 0; this.vy = Math.sin(Date.now()*0.002); }
                if (type === 'water') { this.vx = 0; this.vy = 3 + Math.random() * 3; }
                if (type === 'boss') { this.vx = 4; this.vy = 3; }
                
                this.hp = type === 'boss' ? 20 : (type === 'germ_tough' ? 3 : 1);
                this.maxHp = this.hp;
                this.active = true;
                
                this.scale = 0;
                this.targetScale = 1;
                this.hitTimer = 0;
                
                this.emoji = this.getEmoji(type, stageType);
            }
            
            getEmoji(type, stageType) {
                if (type === 'soap') return '🧼';
                if (type === 'water') return '💧';
                if (type === 'boss') return '👾';
                if (stageType === 'germ_tough') return '👿';
                if (stageType === 'germ_small') return '🧫';
                return ['🦠', '🤢', '🦟'][Math.floor(Math.random() * 3)];
            }

            update(w, h) {
                if (!this.active) return;
                
                // Pop-in animation
                if (this.scale < this.targetScale) this.scale += 0.08;

                // Hit effect timer
                if (this.hitTimer > 0) this.hitTimer--;

                // Move
                this.x += this.vx;
                this.y += this.vy;
                
                // Boss erratic movement
                if (this.type === 'boss' && Math.random() < 0.05) {
                    this.vx = (Math.random() - 0.5) * 15;
                    this.vy = (Math.random() - 0.5) * 15;
                }

                // Hovering soap effect
                if (this.type === 'soap') this.y += Math.sin(Date.now()*0.005) * 2;

                // Water falling logic
                if (this.type === 'water' && this.y > h + this.radius) {
                    this.y = -this.radius;
                    this.x = Math.random() * w;
                }

                // Bounce off walls (except water)
                if (this.type !== 'water') {
                    if (this.x - this.radius < 0) { this.x = this.radius; this.vx *= -1; }
                    if (this.x + this.radius > w) { this.x = w - this.radius; this.vx *= -1; }
                    if (this.y - this.radius < 0) { this.y = this.radius; this.vy *= -1; }
                    if (this.y + this.radius > h) { this.y = h - this.radius; this.vy *= -1; }
                }
            }

            draw(ctx) {
                if (!this.active) return;
                
                ctx.save();
                ctx.translate(this.x, this.y);
                
                let currentScale = this.scale;
                if (this.hitTimer > 0) {
                    currentScale *= 0.7; // Shrink visually when hit
                }
                
                ctx.scale(currentScale, currentScale);
                
                // Draw glowing aura behind emoji
                ctx.beginPath();
                ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
                if (this.type === 'soap') ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
                else if (this.type === 'water') ctx.fillStyle = 'rgba(0, 200, 255, 0.4)';
                else if (this.type === 'boss') ctx.fillStyle = 'rgba(255, 0, 0, 0.4)';
                else ctx.fillStyle = 'rgba(150, 255, 0, 0.4)';
                ctx.shadowBlur = 15;
                ctx.shadowColor = ctx.fillStyle;
                ctx.fill();

                // Draw Emoji
                ctx.shadowBlur = 0;
                ctx.font = `${this.radius * 1.5}px Arial`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(this.emoji, 0, 0);
                
                // HP Bar for Boss / Tough
                if (this.maxHp > 1) {
                    const barW = this.radius * 1.5;
                    const barH = 8;
                    const barY = -this.radius - 15;
                    ctx.fillStyle = 'rgba(255,0,0,0.8)';
                    ctx.fillRect(-barW/2, barY, barW, barH);
                    ctx.fillStyle = '#00FF00';
                    ctx.fillRect(-barW/2, barY, barW * (this.hp / this.maxHp), barH);
                    ctx.strokeStyle = '#FFF';
                    ctx.lineWidth = 2;
                    ctx.strokeRect(-barW/2, barY, barW, barH);
                }
                
                ctx.restore();
            }
            
            takeDamage() {
                if (this.hitTimer > 0) return false; // i-frames
                this.hp--;
                this.hitTimer = 15; // frames
                if (this.hp <= 0) {
                    this.active = false;
                    return true; // Killed
                }
                return false; // Just damaged
            }
        }

        // Particle System for popping effect
        class Particle {
            constructor(x, y, color) {
                this.x = x;
                this.y = y;
                this.vx = (Math.random() - 0.5) * 15;
                this.vy = (Math.random() - 0.5) * 15;
                this.life = 1.0;
                this.color = color;
                this.size = Math.random() * 6 + 3;
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.life -= 0.03;
            }
            draw(ctx) {
                if (this.life <= 0) return;
                ctx.fillStyle = `rgba(${this.color}, ${this.life})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function createExplosion(x, y, type) {
            let color = '150, 255, 0'; // Germ green
            if (type === 'soap') color = '255, 255, 255';
            if (type === 'water') color = '0, 200, 255';
            if (type === 'boss') color = '255, 50, 50';
            
            for (let i = 0; i < 15; i++) {
                particles.push(new Particle(x, y, color));
            }
        }

        // --- GAME CONTROLLER ---

        function updateHUD() {
            document.getElementById('ui-score').innerText = score;
            document.getElementById('ui-timer').innerText = stageTimeLeft;
        }

        function spawnStage(index) {
            gameObjects = [];
            const stage = STAGES[index];
            
            document.getElementById('ui-stage-title').innerText = stage.title;
            document.getElementById('ui-stage-desc').innerText = stage.instruction;
            
            stageTimeLeft = stage.duration;
            updateHUD();

            const w = canvas.width;
            const h = canvas.height;
            
            for (let i = 0; i < stage.count; i++) {
                let x, y, radius = 45;
                let t = stage.type;
                let cType = 'germ'; // Core type for generic
                
                if (t === 'soap') {
                    x = w / 2; y = h / 2; radius = 70; cType = 'soap';
                } else if (t === 'water') {
                    x = Math.random() * w; y = Math.random() * h; cType = 'water';
                } else if (t === 'boss') {
                    x = w / 2; y = h / 3; radius = 120; cType = 'boss';
                } else {
                    // Position patterns based on washing steps
                    if (t === 'germ_center') {
                        x = w/2 + (Math.random()-0.5)*300; y = h/2 + (Math.random()-0.5)*300;
                    } else if (t === 'germ_sides') {
                        x = i % 2 === 0 ? w*0.1 + Math.random()*100 : w*0.9 - Math.random()*100;
                        y = h*0.3 + Math.random()*h*0.4;
                    } else {
                        x = w*0.2 + Math.random()*w*0.6; y = h*0.2 + Math.random()*h*0.6;
                    }
                    if (t === 'germ_small') radius = 25;
                    if (t === 'germ_tough') radius = 60;
                }
                
                gameObjects.push(new Entity(x, y, radius, cType, t));
            }
        }

        function startGame() {
            initAudio();
            gameState = 'PLAYING';
            score = 0;
            killCount = 0;
            currentStageIndex = 0;
            
            document.getElementById('start-screen').classList.replace('fade-in', 'fade-out');
            document.getElementById('game-over-screen').classList.replace('fade-in', 'fade-out');
            document.getElementById('hud').classList.replace('fade-out', 'fade-in');
            
            spawnStage(currentStageIndex);
            playSound('success');

            if (gameTimerInterval) clearInterval(gameTimerInterval);
            gameTimerInterval = setInterval(() => {
                if (gameState === 'PLAYING' && stageTimeLeft > 0) {
                    stageTimeLeft--;
                    updateHUD();
                }
            }, 1000);
        }

        function endGame() {
            gameState = 'GAMEOVER';
            clearInterval(gameTimerInterval);
            playSound('win');
            
            document.getElementById('hud').classList.replace('fade-in', 'fade-out');
            document.getElementById('game-over-screen').classList.replace('fade-out', 'fade-in');
            
            document.getElementById('ui-final-score').innerText = score;
            document.getElementById('ui-kills').innerText = killCount;
            
            let rank = "นักล่าเชื้อโรค";
            let colorClass = "text-yellow-400";
            if (score > 8000) { rank = "ฮีโร่มือสะอาด 🦸‍♂️✨"; colorClass = "text-green-400"; }
            else if (score > 4000) { rank = "นักปราบเชื้อโรค 🛡️"; colorClass = "text-blue-400"; }
            
            const rankEl = document.getElementById('ui-rank');
            rankEl.innerText = rank;
            rankEl.className = `font-black text-5xl bg-white/10 px-6 py-2 rounded-full border-2 ${colorClass}`;
        }

        // --- MEDIA PIPE & AR LOGIC ---

        const videoElement = document.getElementById('webcam');
        let latestVideoFrame = null;
        let latestHands = [];
        let videoTransform = { x:0, y:0, w:0, h:0 };

        // AR UI Interaction State
        let hoverTarget = null;
        let hoverProgress = 0;
        let hoverX = 0, hoverY = 0;

        function calcVideoCover(videoW, videoH, canvasW, canvasH) {
            const vRatio = videoW / videoH;
            const cRatio = canvasW / canvasH;
            let w, h, x, y;
            if (cRatio > vRatio) { // Canvas wider, fit width
                w = canvasW; h = canvasW / vRatio;
                x = 0; y = (canvasH - h) / 2;
            } else { // Canvas taller, fit height
                h = canvasH; w = canvasH * vRatio;
                x = (canvasW - w) / 2; y = 0;
            }
            return { w, h, x, y };
        }

        function getCanvasPoint(normalizedPoint) {
            // Because video is mirrored visually via scale(-1, 1), 
            // the MediaPipe X coordinate (which is 0 on left of image)
            // mapped to our canvas directly will align perfectly with the mirrored image.
            return {
                x: normalizedPoint.x * videoTransform.w + videoTransform.x,
                y: normalizedPoint.y * videoTransform.h + videoTransform.y
            };
        }

        // Initialize MediaPipe Hands
        const hands = new Hands({locateFile: (file) => {
            return `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`;
        }});
        hands.setOptions({
            maxNumHands: 2,
            modelComplexity: 1,
            minDetectionConfidence: 0.6,
            minTrackingConfidence: 0.6
        });

        hands.onResults((results) => {
            if (gameState === 'INIT') {
                gameState = 'START';
                document.getElementById('loading-screen').classList.add('fade-out');
                document.getElementById('start-screen').classList.replace('fade-out', 'fade-in');
            }
            
            latestVideoFrame = results.image;
            // Flip X coordinates of landmarks to match mirror mode
            if (results.multiHandLandmarks) {
                latestHands = results.multiHandLandmarks.map(l => l.map(p => ({ x: 1 - p.x, y: p.y })));
            } else {
                latestHands = [];
            }
        });

        // Initialize Camera
        const camera = new Camera(videoElement, {
            onFrame: async () => {
                await hands.send({image: videoElement});
            },
            width: 640,
            height: 480
        });
        camera.start();

        // --- RENDER LOOP ---

        function drawNeonSkeleton(hand) {
            ctx.save();
            const connections = [
                [0,1],[1,2],[2,3],[3,4], // Thumb
                [0,5],[5,6],[6,7],[7,8], // Index
                [5,9],[9,10],[10,11],[11,12], // Middle
                [9,13],[13,14],[14,15],[15,16], // Ring
                [13,17],[0,17],[17,18],[18,19],[19,20] // Pinky & Palm
            ];

            const pts = hand.map(p => getCanvasPoint(p));

            // Glow Lines
            ctx.shadowBlur = 20;
            ctx.shadowColor = '#00FFFF';
            ctx.strokeStyle = '#FFFFFF';
            ctx.lineWidth = 6;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';

            ctx.beginPath();
            connections.forEach(([i, j]) => {
                ctx.moveTo(pts[i].x, pts[i].y);
                ctx.lineTo(pts[j].x, pts[j].y);
            });
            ctx.stroke();
            
            // Core Lines
            ctx.shadowBlur = 0;
            ctx.strokeStyle = '#00FFFF';
            ctx.lineWidth = 3;
            ctx.stroke();

            // Joint Dots
            ctx.shadowBlur = 10;
            ctx.shadowColor = '#FF00FF';
            ctx.fillStyle = '#FFFFFF';
            pts.forEach(p => {
                ctx.beginPath();
                ctx.arc(p.x, p.y, 6, 0, Math.PI * 2);
                ctx.fill();
            });

            ctx.restore();
        }

        function renderLoop() {
            requestAnimationFrame(renderLoop);
            
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // 1. Draw Mirrored Video Background
            if (latestVideoFrame) {
                videoTransform = calcVideoCover(latestVideoFrame.width, latestVideoFrame.height, canvas.width, canvas.height);
                
                ctx.save();
                // Mirror logic on canvas
                ctx.translate(canvas.width, 0);
                ctx.scale(-1, 1);
                
                // Draw video centered & cropped (object-fit: cover behavior)
                // Note: Because canvas is scaled(-1,1), we draw normally, it will be flipped visually.
                ctx.drawImage(latestVideoFrame, videoTransform.x, videoTransform.y, videoTransform.w, videoTransform.h);
                ctx.restore();
                
                // Add a dark overlay to make game elements pop
                ctx.fillStyle = 'rgba(17, 24, 39, 0.4)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
            }

            // 2. Handle missing hand warning logic
            if (gameState === 'PLAYING') {
                if (latestHands.length === 0) {
                    noHandTimer++;
                    if (noHandTimer > 30) document.getElementById('bounds-warning').classList.replace('fade-out', 'fade-in');
                } else {
                    noHandTimer = 0;
                    document.getElementById('bounds-warning').classList.replace('fade-in', 'fade-out');
                }
            }

            // 3. Update & Draw Game Objects
            if (gameState === 'PLAYING') {
                let allCleared = true;
                
                gameObjects.forEach(obj => {
                    obj.update(canvas.width, canvas.height);
                    obj.draw(ctx);
                    if (obj.active) allCleared = false;
                });
                
                particles.forEach((p, index) => {
                    p.update();
                    p.draw(ctx);
                    if (p.life <= 0) particles.splice(index, 1);
                });

                // Stage Complete Logic
                if (allCleared && gameObjects.length > 0) {
                    score += stageTimeLeft * 20; // Time bonus
                    playSound('success');
                    currentStageIndex++;
                    if (currentStageIndex < STAGES.length) {
                        spawnStage(currentStageIndex);
                    } else {
                        endGame();
                    }
                }
            }

            // 4. Draw AR Hands & Process Interactions
            let currentHoverHTML = null;

            latestHands.forEach(hand => {
                drawNeonSkeleton(hand);

                // Define interaction points (Fingertips and Palm)
                const hitPoints = [0, 4, 8, 12, 16, 20].map(idx => getCanvasPoint(hand[idx]));
                const indexTip = getCanvasPoint(hand[8]); // Used for UI clicking

                // In-Game Collision Detection
                if (gameState === 'PLAYING') {
                    gameObjects.forEach(obj => {
                        if (!obj.active) return;
                        
                        for (let pt of hitPoints) {
                            const dist = Math.hypot(pt.x - obj.x, pt.y - obj.y);
                            if (dist < obj.radius + 20) {
                                // Collision!
                                if (obj.takeDamage()) {
                                    playSound('pop');
                                    score += 100;
                                    if(obj.type !== 'soap' && obj.type !== 'water') killCount++;
                                    createExplosion(obj.x, obj.y, obj.type);
                                } else {
                                    playSound('hit');
                                    createExplosion(pt.x, pt.y, 'hit');
                                }
                                updateHUD();
                                break; // Prevent multiple hits on same object in one frame
                            }
                        }
                    });
                }

                // UI DOM Collision (Hover Progress)
                const interactables = document.querySelectorAll('.ar-interact');
                interactables.forEach(el => {
                    // Check if element is visible
                    if (window.getComputedStyle(el.parentElement).opacity === '0') return;
                    
                    const rect = el.getBoundingClientRect();
                    if (indexTip.x >= rect.left && indexTip.x <= rect.right && 
                        indexTip.y >= rect.top && indexTip.y <= rect.bottom) {
                        currentHoverHTML = el;
                        hoverX = indexTip.x;
                        hoverY = indexTip.y;
                    }
                });
            });

            // 5. Manage UI Hover Progress Ring
            if (currentHoverHTML) {
                if (currentHoverHTML === hoverTarget) {
                    hoverProgress += 2; // Fill speed
                    if (hoverProgress === 2) playSound('hover'); // Initial entry sound
                    
                    if (hoverProgress >= 100) {
                        // Click Triggered
                        hoverProgress = 0;
                        playSound('success');
                        if (currentHoverHTML.id === 'btn-start') startGame();
                        if (currentHoverHTML.id === 'btn-replay') startGame();
                        hoverTarget = null;
                    }
                } else {
                    hoverTarget = currentHoverHTML;
                    hoverProgress = 0;
                }
            } else {
                hoverTarget = null;
                hoverProgress = Math.max(0, hoverProgress - 4); // Decay
            }

            // Draw Hover Loading Ring at finger position
            if (hoverProgress > 0) {
                ctx.save();
                ctx.translate(hoverX, hoverY);
                
                // Background circle
                ctx.beginPath();
                ctx.arc(0, 0, 35, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(0,0,0,0.5)';
                ctx.fill();
                ctx.strokeStyle = 'rgba(255,255,255,0.2)';
                ctx.lineWidth = 6;
                ctx.stroke();
                
                // Progress Arc
                ctx.beginPath();
                ctx.arc(0, 0, 35, -Math.PI/2, -Math.PI/2 + (Math.PI * 2 * (hoverProgress / 100)));
                ctx.strokeStyle = '#10B981'; // Tailwind emerald-500
                ctx.lineWidth = 6;
                ctx.lineCap = 'round';
                ctx.stroke();
                
                ctx.restore();
            }
        }

        // Start render loop
        renderLoop();
    </script>
</body>
</html>
